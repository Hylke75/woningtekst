# Korff de Gidts | Woningtekst Studio — configuratie
# Kopieer naar .env.local (lokaal) of stel in als Vercel Environment Variables.
# Zet NOOIT geheimen in NEXT_PUBLIC_-variabelen; die komen in de browser terecht.

# --- Publiek (browser) --------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Basis-URL van de applicatie (voor links in e-mails); per omgeving verschillend.
NEXT_PUBLIC_APP_URL=https://woningtekst.example.nl

# --- Server (geheim) ----------------------------------------------------------
# Willekeurige string van minimaal 32 tekens. Alleen de SHA-256-hash staat in de
# database (private.server_secrets). Genereren: openssl rand -hex 32
SERVER_RPC_SECRET=
# Anthropic Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Optioneel ander model voor extractie (standaard ANTHROPIC_MODEL)
ANTHROPIC_EXTRACTION_MODEL=
# Lichter model voor SEO/hashtags, alt-teksten en social-hergeneratie (standaard claude-sonnet-5-5)
ANTHROPIC_LIGHT_MODEL=claude-sonnet-5-5
# low | medium | high | xhigh | max (standaard medium)
ANTHROPIC_EFFORT=medium
# default = server-side fallback bij een weigering; off = uit
ANTHROPIC_FALLBACKS=default
ANTHROPIC_TIMEOUT_MS=240000
# Omrekenkoers voor geschatte kosten (USD → EUR)
AI_USD_TO_EUR=0.92

# Optioneel: Supabase secret key, ALLEEN voor het versturen van uitnodigingsmails.
# Zonder deze sleutel werkt alles; uitgenodigden activeren dan zelf via /registreren.
SUPABASE_SECRET_KEY=

# Optioneel: meldingen per e-mail via Resend (ter goedkeuring, dagelijkse beheerdersmail).
# Zonder sleutel staan meldingen alleen in de app (dashboard).
RESEND_API_KEY=
MAIL_FROM="Korff de Gidts Woningtekst Studio <woningtekst@mail.korffdegidts.nl>"

# Optioneel: geheim voor Vercel Cron (/api/cron/dagelijks). Vercel stuurt het als
# "Authorization: Bearer <CRON_SECRET>". Genereren: openssl rand -hex 32
CRON_SECRET=

# Optioneel: webhook (https) voor foutmeldingen, bijv. Slack of Microsoft Teams.
ALERT_WEBHOOK_URL=

# Alleen in Preview: zet op true NADAT Preview naar een eigen test-Supabase-project wijst.
# Zonder deze bevestiging weigert een Preview-deployment te draaien (bescherming productiedata).
PREVIEW_DATABASE_ISOLATED=

# Uploads
UPLOAD_MAX_FILE_MB=20
UPLOAD_MAX_FILES_PER_PROPERTY=40
SIGNED_URL_TTL_SECONDS=120

# Alleen voor tests/lokaal: deterministische AI zonder kosten. Wordt in productie geweigerd.
AI_MOCK=false
